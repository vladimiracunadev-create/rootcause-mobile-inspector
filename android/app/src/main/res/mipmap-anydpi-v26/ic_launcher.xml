<?xml version="1.0" encoding="utf-8"?>
<!-- Ícono adaptativo (Android 8+): el lanzador aplica su propia máscara
     (círculo, squircle, gota). La marca ocupa 56 dp de los 108 dp del
     lienzo, dentro de la zona segura de 66 dp: no se recorta en ninguna.
     `monochrome` habilita el ícono temático de Android 13+.
     Se regenera con `python scripts/make_app_icons.py`. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
